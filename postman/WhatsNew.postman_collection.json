          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"questions\": [\n    {\n      \"type\": \"prelims\",\n      \"question\": \"Which article of the Constitution deals with the Right to Constitutional Remedies?\",\n      \"options\": [\"Article 19\", \"Article 32\", \"Article 21\", \"Article 14\"],\n      \"answer\": \"Article 32\",\n      \"explanation\": \"Dr. Ambedkar called Article 32 the heart and soul of the Constitution.\",\n      \"subject\": \"Polity & Governance\",\n      \"topic\": \"Fundamental Rights - Right to Constitutional Remedies & Writs\",\n      \"tags\": [\"Polity\"],\n      \"difficulty\": \"easy\"\n    },\n    {\n      \"type\": \"prelims\",\n      \"question\": \"Repo rate is decided by which body?\",\n      \"options\": [\"SEBI\", \"Finance Ministry\", \"RBI (MPC)\", \"NITI Aayog\"],\n      \"answer\": \"RBI (MPC)\",\n      \"tags\": [\"Economy\"]\n    },\n    {\n      \"type\": \"mains\",\n      \"question\": \"Critically examine the role of cooperative federalism in India's fiscal architecture.\",\n      \"hints\": [\"GST Council\", \"Finance Commission\", \"cesses & surcharges\"],\n      \"modelAnswer\": \"Cooperative federalism balances centre-state fiscal relations via the GST Council and Finance Commission...\",\n      \"subject\": \"Polity & Governance\",\n      \"topic\": \"Federalism\",\n      \"tags\": [\"Polity\"],\n      \"maxMarks\": 15\n    }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "questions"] },
