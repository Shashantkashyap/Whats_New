# =============================================================================
# What's New backend — single env file for the bundled artifact.
# Copy to `.env` (same directory you run the binary from) and fill in.
#   cp .env.example .env
#   npm run build           # produces dist/whatsnew-backend.cjs
#   node dist/whatsnew-backend.cjs
# =============================================================================

# --- Server ---
# One port serves the whole API (auth + users + news + topics + content).
PORT=8080

# --- MongoDB (required) ---
# A single database holds all collections (users, otps, news).
MONGO_URI=mongodb://localhost:27017/whats_new

# --- JWT (required) ---
# Shared by login (token minting) and the content bearer-auth middleware.
# Replace with strong random strings before any shared/prod deploy.
JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# --- Google Gemini (required only for the content pipeline) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Email / OTP (required for register, verify-otp, forgot/reset password) ---
# Gmail App Password (needs 2FA): https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# --- Content images (optional but recommended) ---
# Article images are resolved at ingest time: Pixabay -> Unsplash -> subject fallback.
# Pixabay is free and key-only: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=          # optional secondary; subject fallback used if both unset

# --- Persistent media upload (required in production) ---
# Hotlinked Pixabay/Unsplash images are downloaded and re-hosted via this API.
# The storage URL is kept server-side only; APIs return image_document_id and
# clients fetch bytes from GET /api/v1/media/:id.
ASSET_UPLOAD_URL=https://api.event.nextwavesaas.tech/api/forms/schemas/upload-asset
ASSET_UPLOAD_TOKEN=
# ASSET_UPLOAD_TYPE=form_logo

# --- Optional ---
# NODE_ENV=production           # enables secure cookies
# NEWS_PROVIDER=rss             # "rss" (default) or "chrome-mcp" (needs extra deps)

# --- Schedulers (in-process node-cron; start with the API process) ---
# ENABLE_SCHEDULERS=true        # default true; set false for local one-off runs
# CRON_TZ=Asia/Kolkata
# CONTENT_PIPELINE_CRON=0 */2 * * *   # every 2 hours — news feed pipeline
# CONTENT_PIPELINE_MODE=prod
# QUESTION_BANK_CRON=0 * * * *        # every 1 hour — grow question bank
# QUESTION_TOPICS_PER_RUN=6           # topics per hourly tick (rotates)
# QUESTION_PRELIMS_PER_TOPIC=2
# QUESTION_MAINS_PER_TOPIC=1
# QUESTION_MIN_IMPORTANCE=3
